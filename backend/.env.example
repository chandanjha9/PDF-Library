# ─────────────────────────────────────────────────────────────
# PDF Library Backend — Environment Configuration
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Your Telegram Bot token from @BotFather
BOT_TOKEN=1234567890:ABCDEFGHijklmnopqrstuvwxyz_example

# Numeric ID of the Telegram channel that contains the PDFs.
# To find it: forward a message from the channel to @userinfobot
# It will look like -1001234567890
CHANNEL_ID=-1001234567890

# Public HTTPS URL where Telegram will POST webhook updates.
# For local testing: install ngrok, run `ngrok http 3000`, use the https URL.
# For production: your server's public domain, e.g. https://api.myapp.com
WEBHOOK_URL=https://your-subdomain.ngrok-free.dev
# Port the Express server listens on
PORT=3000

# Optional: random string to verify webhook requests come from Telegram
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=change_me_to_a_random_secret

# ── Optional ─────────────────────────────────────────────────────────────────
# Point at a local Bot API server to lift the 20 MB file limit (or for tests).
# TELEGRAM_API_BASE=https://api.telegram.org
# Minimum fuzzy score (0–1) before a request is granted a 20-minute pass.
# GRANT_MIN_SCORE=0.5
# Minimum gap between on-demand channel re-scans triggered by missed requests (ms).
# SYNC_COOLDOWN_MS=300000
# Use a different LokiJS data file (tests / staging).
# LIBRARY_DB_PATH=./data/library.json
# Serve a specific APK at GET /apk (defaults to the newest debug build found).
# APK_PATH=
# ── Premium (20 MB+ books: ₹10 UPI or rewarded ad) ──────────────────────────
# Size above which a book is Premium (bytes). Default 20 MB.
# PREMIUM_MIN_BYTES=20971520
# false (default on the official Bot API) = MANUAL delivery: after ₹10/ad the
# order is sent to ADMIN_CHAT_ID on Telegram (with the book file) and you
# forward it to the customer. Set true once TELEGRAM_API_BASE points at your
# own Bot API server → the app then downloads premium books itself.
# LARGE_FILES_ENABLED=false
# Your numeric Telegram user id (get it from @userinfobot). Press Start in your
# bot's chat once so the bot is allowed to message you.
# ADMIN_CHAT_ID=123456789
# Protects GET /admin/unlocks and POST /admin/sync  (…?key=<ADMIN_KEY>)
# ADMIN_KEY=change_me
