<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Downloaded PDFs are re-downloadable; don't back them up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pdfs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pdfs/" />
    </device-transfer>
</data-extraction-rules>
